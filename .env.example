# Banco de dados (lido pelo PostgreSQL e pelo backend)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Usados ao rodar o backend fora do Docker.
# No docker compose, o backend usa POSTGRES_HOST=db e POSTGRES_PORT=5432 automaticamente.
POSTGRES_HOST=
POSTGRES_PORT=

# Porta do PostgreSQL exposta no host pelo docker compose
DB_HOST_PORT=
